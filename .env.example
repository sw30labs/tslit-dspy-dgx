# TSLIT-DSPy on NVIDIA DGX Spark
# Detection stack: non-adversary / American models only.
# Adversary-origin models (Qwen, DeepSeek, MiniMax, …) are scan *targets*, never the detector.

# ---------------------------------------------------------------------------
# Ollama — the only local LLM server
# Catalog: curl http://127.0.0.1:11434/api/tags
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=muse-glimmer:30b-bf16
OLLAMA_API_KEY=ollama
OLLAMA_TIMEOUT_S=600
# Detector must emit JSON in content. Leave think off (Muse Glimmer otherwise
# spends the budget in a reasoning channel and DSPy parses {}).
OLLAMA_THINK=false
OLLAMA_MAX_TOKENS=4096

# DO NOT use these as OLLAMA_MODEL for the analyzer (adversary-origin / target-only):
#   qwen3.8:27b-mtp-bf16
#   ornith-1.5:35b
#   deepseek-v4-flash-0731:ud-iq2-m
# Those remain valid as *scan targets* when probing:
#   ./tslit scan --target-model qwen3.8:27b-mtp-bf16
