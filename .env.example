# TSLIT-DSPy on NVIDIA DGX Spark
# Detection stack: non-adversary / American models only.
# Adversary-origin models (Qwen, DeepSeek, MiniMax, …) are scan *targets*, never the detector.

# Provider: vllm (default) | ollama | cloud
TSLIT_MODEL_PROVIDER=vllm

# ---------------------------------------------------------------------------
# vLLM — local OpenAI-compatible server (DGX default)
# Detection brain recipe (REQUIRED for integrity testing):
#   ~/Desktop/start-vllm.sh nemotron-super
#   or: ~/Desktop/serve-local-llm.sh up nemotron-super
# Catalog: curl -H 'Authorization: Bearer local' http://127.0.0.1:8000/v1/models
# ---------------------------------------------------------------------------
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_MODEL=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-NVFP4
VLLM_API_KEY=test
VLLM_TIMEOUT_S=600

# DO NOT use these as VLLM_MODEL for the analyzer (adversary-origin / target-only):
#   Qwen/Qwen3.6-27B-FP8
#   Qwen/Qwen3-Coder-Next-FP8
# Those remain valid as *scan targets* when probing third-party models.

# Optional US open validation model when served via vLLM/Ollama:
# VLLM_MODEL=openai/gpt-oss-120b

# ---------------------------------------------------------------------------
# Cloud US models (optional — compile with Sonnet / infer with Opus)
# ---------------------------------------------------------------------------
# TSLIT_MODEL_PROVIDER=cloud
# TSLIT_CLOUD_MODEL=anthropic/claude-opus-4-6
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Ollama (optional fallback — still enforce US / non-adversary models)
# ---------------------------------------------------------------------------
# TSLIT_MODEL_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1
