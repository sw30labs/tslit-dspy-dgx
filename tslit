#!/usr/bin/env bash
# Thin DGX-friendly launcher (mirrors greyswan / driftlab UX).
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd "${ROOT}"

PYTHON="${TSLIT_PYTHON:-}"
if [[ -z "${PYTHON}" ]]; then
  if [[ -x "${ROOT}/.venv/bin/python" ]]; then
    PYTHON="${ROOT}/.venv/bin/python"
  elif command -v python3.12 >/dev/null 2>&1; then
    PYTHON="python3.12"
  else
    PYTHON="python3"
  fi
fi

export PATH="${ROOT}/.venv/bin:${PATH}"

usage() {
  cat <<EOF
Usage: $(basename "$0") <command> [args...]

Commands:
  install              Create .venv and install package (setup-venv.sh)
  doctor               Host + data + Ollama + model-origin policy
  policy               Print non-adversary / American model policy
  test-ollama          Catalog + tiny completion against local Ollama
  smoke                Offline import + policy checks (no GPU)
  evaluate [args...]   Run detector evaluation
  optimize [args...]   MIPROv2 compile (expensive)
  experiment [--mini]  cartoon exam on frozen test.jsonl (not Qwen)
  scan [args...]       Probe target (Qwen) + analyze with Muse Glimmer
  pytest [args...]     Run unit tests
  test-probe           a) one live probe          scripts/test_one_probe.sh
  test-campaign        b) full mini campaign      scripts/test_mini_campaign.sh
  test-campaign-plus   increment mini from old TSLIT payload
  test-campaign-sharp  clock-native dual-use grid (20 probes)
  test-targets         c) other box targets       scripts/test_other_targets.sh
  test-eval            d) detector eval on JSONL  scripts/test_evaluate.sh
  test-experiment      cartoon exam               scripts/test_experiment.sh
  test-offline         smoke + pytest + catalog   scripts/test_offline.sh
  help                 This help

Examples:
  ./tslit install
  ./tslit doctor
  ./tslit test-ollama
  ./tslit test-probe
  ./tslit test-campaign
  ./tslit test-targets
  ./tslit test-eval
  ./tslit evaluate --use-compiled --test workspace/data/dev.jsonl
  ./tslit experiment --mini

Environment:
  TSLIT_PYTHON         Python binary (default: .venv/bin/python or python3.12)
  See .env.example for OLLAMA_* settings.

Detection LM (required for live eval):
  Meta Muse Glimmer via Ollama (OLLAMA_MODEL=muse-glimmer:30b-bf16)
  Do NOT point OLLAMA_MODEL at Qwen / DeepSeek tags for the analyzer.
EOF
}

if [[ $# -eq 0 ]]; then
  usage
  exit 0
fi

cmd="${1:-help}"
shift || true

case "${cmd}" in
  -h|--help|help)
    usage
    ;;
  install|setup)
    exec bash "${ROOT}/setup-venv.sh" "$@"
    ;;
  test-vllm)
    # Compat: vLLM layer is gone; same smoke against Ollama.
    exec "${PYTHON}" -m tslit_dspy.cli test-ollama "$@"
    ;;
  doctor|policy|test-ollama|smoke|evaluate|optimize|experiment|scan)
    exec "${PYTHON}" -m tslit_dspy.cli "${cmd}" "$@"
    ;;
  test-probe|test-one-probe)
    exec bash "${ROOT}/scripts/test_one_probe.sh" "$@"
    ;;
  test-campaign|test-mini)
    exec bash "${ROOT}/scripts/test_mini_campaign.sh" "$@"
    ;;
  test-campaign-plus|test-plus)
    exec bash "${ROOT}/scripts/test_campaign_plus.sh" "$@"
    ;;
  test-campaign-sharp|test-sharp)
    exec bash "${ROOT}/scripts/test_campaign_sharp.sh" "$@"
    ;;
  test-targets)
    exec bash "${ROOT}/scripts/test_other_targets.sh" "$@"
    ;;
  test-eval|test-evaluate)
    exec bash "${ROOT}/scripts/test_evaluate.sh" "$@"
    ;;
  test-experiment)
    exec bash "${ROOT}/scripts/test_experiment.sh" "$@"
    ;;
  test-offline)
    exec bash "${ROOT}/scripts/test_offline.sh" "$@"
    ;;
  pytest|test)
    exec "${PYTHON}" -m pytest "$@"
    ;;
  *)
    echo "unknown command: ${cmd}" >&2
    usage
    exit 1
    ;;
esac
